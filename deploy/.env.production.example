# Copie para .env.production e preencha os valores do servidor.
I7AI_IMAGE_TAG=local
POSTGRES_USER=i7ai
POSTGRES_PASSWORD=
POSTGRES_DB=i7ai
DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=
# Imagens aprovadas e fixadas em tag/digest.
MINIO_IMAGE=
MINIO_MC_IMAGE=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
S3_BUCKET=i7ai-documents
JWT_SECRET=
SGDM_JWT_SECRET=
SGDM_JWT_ISSUER=
SGDM_JWT_AUDIENCE=
CORS_ORIGINS=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
# LiteLLM na mesma VPS, pela rede Docker interna (sem URL pública).
OMNIROUTER_BASE_URL=http://litellm:4000/v1
# Igual a LITELLM_MASTER_KEY.
OMNIROUTER_API_KEY=
OMNIROUTER_INTERNAL_HOSTS=litellm
# Imagem testada (1.106.4). Prefira o digest a uma tag móvel.
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:c169fb3adc514fcf210377c203f3de406d54f10bfdacf13948a4a839db9af7de
# Gere com: echo sk-$(openssl rand -hex 32)
LITELLM_MASTER_KEY=
# Criptografa as chaves dos provedores. Nunca altere depois de cadastrar chaves.
LITELLM_SALT_KEY=
# Mesmo Postgres, banco "litellm" (criado automaticamente).
LITELLM_DATABASE_URL=postgresql://USUARIO:SENHA@postgres:5432/litellm
# Somente rotas de chaves de API com termos comerciais; veja docs/GATEWAY.md.
OMNIROUTER_ALLOWED_PREFIXES=openai,anthropic,gemini,xai
CHAT_ATTACHMENT_MAX_BYTES=20971520
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
