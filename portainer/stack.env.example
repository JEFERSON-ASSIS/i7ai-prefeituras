# Variáveis da stack i7ai-plataforma — cole no Portainer → Stack → Environment variables.
#
# ATENÇÃO — os valores abaixo são EXEMPLOS. Gere todos os segredos do zero
# para a VPS e nunca os coloque no Git. Gere cada segredo com:
#   openssl rand -hex 32
# Use só letras e números (hex): as senhas entram em URLs de conexão
# (postgresql://, redis://) e caracteres como @ : / # quebrariam a URL.

# Domínio público do SGDM (sem https://). O i7Ai fica em https://WEB_HOST/i7ai.
WEB_HOST=sgdm.com.br

# Tag das imagens do GHCR (GitHub Actions). Padrão: main.
I7AI_IMAGE_TAG=main

# Senha do Postgres próprio do i7Ai (usuário e banco são fixos: i7ai).
POSTGRES_PASSWORD=change-gere-com-openssl-rand-hex-32

# Senha do Redis próprio do i7Ai.
REDIS_PASSWORD=change-gere-com-openssl-rand-hex-32
# Redis só do cache exato do LiteLLM (i7ai-redis-cache); diferente do REDIS_PASSWORD.
REDIS_CACHE_PASSWORD=change-gere-com-openssl-rand-hex-32

# Usuário do MinIO compartilhado do SGDM, restrito ao bucket do i7Ai. É criado
# no passo 6.1 do runbook (docs/DEPLOY_VPS.md); use aqui os mesmos valores.
I7AI_S3_ACCESS_KEY=i7ai-app
# Senha desse usuário: gere com openssl rand -hex 32.
I7AI_S3_SECRET_KEY=change-gere-com-openssl-rand-hex-32

# Bucket dos documentos (criado antes do deploy, no passo 6.1 do runbook).
S3_BUCKET=i7ai-documents

# Segredo dos tokens do i7Ai (mínimo 32 caracteres).
JWT_SECRET=change-gere-com-openssl-rand-hex-32

# Igual ao JWT_SECRET da stack sgdm-app (valida a sessão do SGDM).
SGDM_JWT_SECRET=change-copie-o-JWT_SECRET-da-stack-sgdm-app

# Gerada aqui, uma vez (openssl rand -hex 32); depois é copiada PARA o
# I7AI_INTEGRACAO_CHAVE da stack sgdm-app (chave da integração SGDM ↔ i7Ai).
SGDM_INTEGRATION_KEY=change-gere-com-openssl-rand-hex-32

# Chave mestra do LiteLLM; deve começar com sk- (ex.: sk- + openssl rand -hex 32).
LITELLM_MASTER_KEY=sk-change-gere-com-openssl-rand-hex-32

# Cifra as chaves dos provedores no banco do LiteLLM. NUNCA troque depois de
# cadastrar chaves: as salvas ficariam ilegíveis.
LITELLM_SALT_KEY=change-gere-com-openssl-rand-hex-32

# Opcional: segundos de cache das liberações de modelo vindas da Central de IA
# do SGDM (padrão 60; com o SGDM fora do ar vale o último valor por até 10 min).
SGDM_ACCESS_CACHE_SECONDS=60

# Opcional: segundos de cache da organização (setores, nome e fuso da prefeitura).
SGDM_ORG_CACHE_SECONDS=300

# Opcional: intervalo (s) da sincronização do catálogo de modelos e dos preços.
MODEL_SYNC_SECONDS=300

# Na stack sgdm-app (não aqui): I7AI_API_URL=http://i7ai-backend:3000/api
# (nomes de agentes e conversas no Consumo da Central de IA).

# Opcional: prefixos de modelo liberados (vazio = padrão do backend).
OMNIROUTER_ALLOWED_PREFIXES=

# Opcional: tamanho máximo de anexo do chat em bytes (padrão 20 MB).
CHAT_ATTACHMENT_MAX_BYTES=20971520

# Opcionais: provedor de embeddings da base de conhecimento (vazio = desligado).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
