# Credenciais abaixo são exclusivas de desenvolvimento local.
DATABASE_URL="postgresql://i7ai:i7ai_dev@localhost:5432/i7ai?schema=public"
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="i7ai"
S3_SECRET_KEY="i7ai_dev_minio"
S3_BUCKET="i7ai-documents"
JWT_SECRET="change-this-in-development"
PORT="3000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
SGDM_JWT_SECRET=""
SGDM_JWT_ISSUER=""
SGDM_JWT_AUDIENCE=""
VITE_API_URL="http://localhost:3000/api"
SEED_ADMIN_PASSWORD=""
AI_GATEWAY_URL=""
AI_GATEWAY_API_KEY=""
# Gateway de IA (LiteLLM local do docker compose). Nunca use prefixo VITE_ para chaves.
# OMNIROUTER_API_KEY deve ser igual a LITELLM_MASTER_KEY.
OMNIROUTER_BASE_URL="http://localhost:4000/v1"
OMNIROUTER_API_KEY="sk-i7ai-dev-local"
# Somente nomes de serviços Docker (sem ponto) que podem usar HTTP na rede interna.
OMNIROUTER_INTERNAL_HOSTS=""
# LiteLLM local. As chaves da OpenAI/Anthropic são cadastradas em Modelos (SUPER_ADMIN).
LITELLM_MASTER_KEY="sk-i7ai-dev-local"
LITELLM_SALT_KEY="sk-i7ai-dev-salt"
# Prefixos de rota liberados para dados da prefeitura (chaves de API com termos comerciais).
# Rotas de assinaturas pessoais (antigravity/, cx/, auto/...) são recusadas.
OMNIROUTER_ALLOWED_PREFIXES="openai,anthropic,gemini,xai"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="text-embedding-3-small"
DOCUMENT_MAX_BYTES="52428800"
CHAT_ATTACHMENT_MAX_BYTES="20971520"
QUEUE_PREFIX="bull"
TOOLS_ALLOW_PRIVATE_NETWORK="false"
# Exemplo de referência de ferramenta: env:TOOL_SECRET_PORTAL
# TOOL_SECRET_PORTAL=""
